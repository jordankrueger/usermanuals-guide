---
import { site } from "../site.config";
---

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>

<form class="contact-form" method="POST" action="/api/submit">
  <label>
    <span>Name</span>
    <input type="text" name="name" autocomplete="name" />
  </label>
  <label>
    <span>Email</span>
    <input type="email" name="email" autocomplete="email" required />
  </label>
  <label>
    <span>Message</span>
    <textarea name="message" rows="5" required></textarea>
  </label>

  <div class="form-hp" aria-hidden="true">
    <label>
      Leave this field empty
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <input type="hidden" name="_site" value={site.domain} />
  <div
    class="cf-turnstile"
    data-sitekey="0x4AAAAAAENA2HoREWB_P761"
    data-action="contact"
    data-appearance="interaction-only"
    data-theme="auto"
  ></div>
  <button class="button button--solid" type="submit">Send message</button>
</form>
